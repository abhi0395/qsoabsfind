SIMPLE  =                    T / conforms to FITS standard                      BITPIX  =                    8 / array data type                                NAXIS   =                    0 / number of array dimensions                     EXTEND  =                    T                                                  AUTHOR  = 'A.Anand '                                                            SURVEY  = 'SDSS    '                                                            DR      = 'DR16    '                                                            ABSORBER= 'CIV     '           / Absorber name                                  KERWIDTH= '[3, 4, 5, 6, 7, 8]' / Kernel width in pixels (ker_fwhm_pixels)       COEFFSIG=                    2 / sigma threshold (coeff_sigma)                  MULTRE  =                    1 / Multiplicative factor for residuals (mult_resi)D_PIX   =                  0.6 / tolerance for line separation (in Ang) (d_pix) PM_PIXEL=                  100 / N_Pixel for noise estimation (pm_pixel)        SN_LINE1=                    3 / S/N threshold for first line (sn_line1)        SN_LINE2=                    2 / S/N threshold for second line (sn_line2)       EWCOVAR =                    T / Use covariance for EW error (use_covariance)   LOGWAVE =                    T / Use log wavelength scaling (logwave)           LAM_ESEP=                   10 / lambda edges to avoid edges (lam_edge_sep)     BLUE_LAM=               1310.0 / blue end of quasar-rest frame (Ang) for search RED_LAM =              1549.48 / red end of quasar-rest frame (Ang) for search  CONTERR =                 0.05 / fractional error in continuum normalization    CONFLEV =  / minimum confidence level for selection                             DV_QSO  =                 5000 / qso velocity separation from absorber (km/s)   RWSTART =                 3800 / start wavelength for resolution curve (Ang)    RVSTART =                 1500 / resolution value at start wavelength           RWEND   =                 9000 / end wavelength for resolution curve (Ang)      RVEND   =                 2500 / resolution value at end wavelength             RES_IS_R=                    T / if True, res_val_start and res_val_end are R vaSNR_CUT =                    3 / S/N cut for spectra (snr_cut)                  SNR_STAT= 'median  '           / statistics for SNR of QSO in search window     DV_EML  =  / mask emission lines in search window within +/- of this value (qso_N_METHOD= 'AODM    '           / Column Density Method: apparent optical depth  DELTA_V =                  240 / +/- velocity (km/s) to calculate optical depth NUMPY   = '1.22.4  '           / numpy version                                  ASTROPY = '6.0.1   '           / astropy version                                SCIPY   = '1.8.1   '           / scipy version                                  NUMBA   = '0.59.1  '           / numba version                                  QSOABFI = '2.1.0.post55+g658a1390c' / qsoabsfind version                        MATPLOT = '3.8.4   '           / matplotlib version                             EXTNAME = 'PRIMARY '                                                            END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             